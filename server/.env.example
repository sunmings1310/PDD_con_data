APP_ENV=development
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_SERVICE=YOUR_SERVICE_HERE
ORACLE_USER=YOUR_USERNAME_HERE
ORACLE_PASSWORD=YOUR_PASSWORD_HERE
JWT_SECRET=YOUR_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_EXPIRE_SEC=43200
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=
HEARTBEAT_TIMEOUT_SEC=90
# 仅首次初始化且数据库尚无超级管理员时需要；请通过安全渠道设置，不要提交实际值。
INITIAL_ADMIN_USERNAME=YOUR_ADMIN_USERNAME_HERE
INITIAL_ADMIN_PASSWORD=YOUR_PASSWORD_HERE
# IMAGE_DIR 未设置时使用项目默认目录。
