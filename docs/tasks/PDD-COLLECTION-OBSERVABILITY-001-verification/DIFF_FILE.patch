+            "WHERE TASK_ID=:task AND SOURCE_TYPE=:source",
+            {"task": self.ids["task"], "source": observations.SOURCE_TYPE},
+        )
+        observations.cleanup_expired(self.cur, limit=10)
+        self.cur.execute(
