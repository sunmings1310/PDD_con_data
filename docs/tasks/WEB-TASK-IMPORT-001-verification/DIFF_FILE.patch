+            cur.execute("SELECT COUNT(*) FROM SJZQ_QUOTA_USAGE WHERE ENTERPRISE_ID=:enterprise_id AND METRIC_CODE=:metric AND PERIOD_KEY=:period",
+                        {"enterprise_id": enterprise_id, "metric": DAILY_SNAPSHOT, "period": new_period})
